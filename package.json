{
  "name": "theaestheticslyrics",
  "productName": "theaestheticslyrics",
  "version": "1.0.1",
  "description": "Word-by-word synced lyrics for Spotify and Apple Music on Windows, on a full-screen lyrics screen or an always-on overlay.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "darshanseenivasakumar (https://github.com/darshanseenivasakumar)",
  "license": "MIT",
  "homepage": "https://github.com/darshanseenivasakumar/theaestheticslyrics#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darshanseenivasakumar/theaestheticslyrics.git"
  },
  "bugs": {
    "url": "https://github.com/darshanseenivasakumar/theaestheticslyrics/issues"
  },
  "keywords": [
    "lyrics",
    "synced-lyrics",
    "word-by-word",
    "spotify",
    "apple-music",
    "windows",
    "electron",
    "lock-screen"
  ],
  "scripts": {
    "predev": "node scripts/build-helper.mjs",
    "dev": "electron-vite dev",
    "prestart": "node scripts/build-helper.mjs",
    "start": "electron-vite preview",
    "prebuild": "node scripts/build-helper.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:helper": "node scripts/build-helper.mjs --force",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-fluent-icons.mjs && electron scripts/make-icons.mjs",
    "snapshot": "electron-vite build && electron . --snapshot=snapshots",
    "package": "npm run build && node scripts/package-win.mjs",
    "fake-player": "electron scripts/fake-player/main.cjs",
    "check:lrclib": "vitest run --config vitest.live.config.ts tests-live/lrclib.live.test.ts",
    "check:audio": "node scripts/build-helper.mjs && vitest run --config vitest.live.config.ts tests-live/audio-capture.live.test.ts"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@iconify-json/fluent": "1.2.58",
    "@types/node": "^24.9.0",
    "electron": "44.4.4",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
